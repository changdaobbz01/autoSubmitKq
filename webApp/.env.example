# 对外 Web 端口
WEB_PORT=8088

# PostgreSQL
POSTGRES_DB=tokenhub
POSTGRES_USER=tokenhub
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD

# 必须为 32 字节随机值的 Base64 编码；部署后不可随意更换
TOKEN_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# 手机网页访问口令和本地程序 API 密钥必须不同，建议都使用独立随机值
MOBILE_ACCESS_KEY=REPLACE_WITH_RANDOM_MOBILE_ACCESS_KEY
DESKTOP_API_KEY=REPLACE_WITH_RANDOM_DESKTOP_API_KEY

# 通常无需修改；上游地址变化时可在这里覆盖
PORTAL_API_URL=http://111.48.251.187:8003/zsyw/code
PORTAL_AREA=湖北
PORTAL_APP_ID=834786
ATTENDANCE_API_URL=https://ad-pro.xyang.xin:20002/iflow/plugins/attendance
